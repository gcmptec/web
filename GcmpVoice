        "# --- Cell 12: Test on real emergencies (boundary focus) ---\n",
        "\n",
        "def predict(text):\n",
        "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=128).to(model.device)\n",
        "    with torch.no_grad():\n",
        "        logits = model(**inputs).logits\n",
        "    probs = torch.softmax(logits, dim=-1)[0]\n",
        "    pred_id = probs.argmax().item()\n",
        "    return id2label[pred_id], probs[pred_id].item()\n",
        "\n",
        "print(\"=== Boundary test: medical vs domestic ===\")\n",
        "print()\n",
        "print(\"--- Should be MEDICAL ---\")\n",
        "for t in [\n",
        "    \"help help she is not breathing\",\n",
        "    \"she's not breathing please come\",\n",
        "    \"he collapsed and won't wake up\",\n",
        "    \"my father just dropped he was holding his arm\",\n",
        "    \"the baby is not breathing\",\n",
        "]:\n",
        "    label, conf = predict(t)\n",
        "    correct = label == \"medical\"\n",
        "    marker = \"✓\" if correct else \"✗\"\n",
        "    print(f\"{marker} {t}\")\n",
        "    print(f\"   -> {label} ({conf:.0%})\")\n",
        "\n",
        "print()\n",
        "print(\"--- Should be DOMESTIC ---\")\n",
        "for t in [\n",
        "    \"he won't stop hitting her\",\n",
        "    \"they are fighting again\",\n",
        "    \"he is drunk and he has a knife\",\n",
        "    \"she locked herself in the bathroom\",\n",
        "    \"he dragged her out of the house\",\n",
        "]:\n",
        "    label, conf = predict(t)\n",
        "    correct = label == \"domestic\"\n",
        "    marker = \"✓\" if correct else \"✗\"\n",
